# The language model: any OpenAI-compatible chat completions endpoint. The demo runs on AMD.
MODEL_BASE_URL=            # e.g. https://<token-factory-host>/v1 or http://localhost:11434/v1 (Ollama, development)
MODEL_API_KEY=
MODEL_NAME=                # a Gemma that accepts images, e.g. google/gemma-3-27b-it, or gemma3:12b on Ollama
MODEL_VISION=1             # 0 = the model takes no images: photos use the committed transcription
MODEL_PRICE_IN_PER_M=0     # USD per 1M input tokens, for the cost estimate; 0 = not shown
MODEL_PRICE_OUT_PER_M=0
MODEL_REASONING_EFFORT=    # "none" for a model that thinks before answering (Ollama gemma4, qwen3); empty = not sent
MODEL_TIMEOUT_S=120
MODEL_HARDWARE=            # shown in the top bar, e.g. "AMD Instinct via AMD Token Factory"

# Voice notes: any OpenAI-compatible /audio/transcriptions endpoint, e.g. vLLM serving Whisper on AMD.
TRANSCRIBE_BASE_URL=       # empty = committed transcripts, labelled "from file"
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=          # e.g. openai/whisper-large-v3

CATORDER_DB=./catorder.db
CATORDER_NO_SAMPLES=       # 1 = do not load the sample messages: the inbox starts empty (production)
CATORDER_TODAY=            # YYYY-MM-DD; empty = real date. Demo and eval use 2026-10-18.
CATORDER_OFFLINE=0         # 1 = never call a model, serve the cache and committed readings only
CATORDER_REFRESH=0         # 1 = ignore the cache and call the models
# Live WhatsApp through the Twilio Sandbox (README). The webhook is off while TWILIO_AUTH_TOKEN is empty.
TWILIO_ACCOUNT_SID=        # ACxxxx, used to download media
TWILIO_CONTENT_SID=       # HXxxxx, twilio/text template with body {{1}}; needed when Twilio answers 21654
TWILIO_AUTH_TOKEN=         # also signs the webhook: empty = POST /webhook/whatsapp answers 503
PUBLIC_URL=                # public https origin Twilio posts to, no trailing slash (a cloudflared URL in development)
WHATSAPP_PHONE_MAP=        # +15005550006=deli-mulino,+15005550007=bar-ponterosso (E.164 = customer id); others become unknown-sender
CATORDER_INBOX_DIR=        # live media; empty = <data dir>/inbox
PORT=7860
CATORDER_MOCK=0            # 1 (or MODEL_BASE_URL empty) = hand-written mock answers, no inference

# Predictive model (model/serve.py, PyTorch; trained on an AMD Radeon Pro W7900D, serves on CPU). Empty = cached predictions only.
PREDICT_BASE_URL=
PREDICT_TOKEN=
