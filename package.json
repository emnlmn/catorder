{
  "name": "catorder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "db-clean": "sh scripts/db-clean.sh",
    "demo": "CATORDER_MOCK=1 CATORDER_TODAY=2026-10-18 tsx src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:ui": "tsc -p tsconfig.ui.json",
    "eval": "tsx eval/runEval.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
